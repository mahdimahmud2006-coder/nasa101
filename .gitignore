# TerraPulse: source and provenance belong in Git; acquired data and generated
# runtime binaries are restored from the versioned runtime download.

# Acquired Earth-observation products, at any location or filename casing
*.[hH]5
*.[hH][dD][fF]
*.[hH][dD][fF]5
*.[hH][eE]5
*.[nN][cC]
*.[nN][cC]4
*.SAFE/
/database/
/database for imp2/
/downloads/
*.download
*.part
*.partial
*.crdownload

# Full-resolution arrays, rasters and packaged deliverables
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.geotiff
*.npy
*.npz
*.zarr/
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar
/dist/
/output/
/runtime-downloads/
/.runtime-staging/

# Generated public products: retain small metadata and provenance in Git.
/web/public/cases/**
!/web/public/cases/**/
!/web/public/cases/**/*.json
!/web/public/cases/**/*.geojson
!/web/public/cases/**/*.md
!/web/public/cases/**/*.csv
!/web/public/cases/**/*.parquet

# Local scientific caches: retain source identities, formulas and inventories.
/data/**
!/data/**/
!/data/**/*.json
!/data/**/*.geojson
!/data/**/*.md
!/data/**/*.csv
!/data/**/*.txt
!/data/**/*.parquet
!/data/palettes/v1/cividis.json
!/data/palettes/v1/vik.json
!/data/palettes/v1/provenance.json
!/data/palettes/v1/cmcrameri_license
!/data/palettes/v1/matplotlib_license
!/data/palettes/v1/matplotlib_source
!/data/palettes/v1/vik_source
# Compact, cited original reference archive; not an acquisition cache.
!/data/context/unosat_20260826_flood_extent.zip

# Generated figures and logs stay local; report metadata and source checks stay.
/reports/**/*.png
/reports/**/*.svg
/reports/**/*.log
/data/**/*.png
/data/**/*.webp
*.log
*.tmp
*.temp
*.bak
*.orig
.cache/
scratch/
tmp/
temp/

